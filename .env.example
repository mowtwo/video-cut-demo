# ---- core ----
DATA_DIR=./data                       # 媒体文件 + sqlite + 输出 的根目录
API_PORT=8787
WEB_PORT=5173

# ---- svc/render (Go ffmpeg microservice) ----
RENDER_PORT=8790
RENDER_URL=http://127.0.0.1:8790
RENDER_HWACCEL=videotoolbox           # videotoolbox(宿主机Mac) | none(容器内libx264)
RENDER_MAX_CONCURRENT=2               # 重型 ffmpeg 并发上限, 留空则按 cores/4 自动
# 指向全功能 ffmpeg(含 libass/libfreetype, 解锁大字标题+字幕)。
# macOS 装 ffmpeg-full 后(keg-only)填下面路径; 留空则用 PATH 里的 ffmpeg(缺则自动跳过文字)。
FFMPEG_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
FFPROBE_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe

# ---- svc/asr (optional, faster-whisper) ----
# 留空则前端隐藏字幕功能、主流程跳过
ASR_URL=
ASR_MODEL=large-v3

# ---- AI refine (optional) ----
# 留空则隐藏 AI 按钮, 普通 regenerate 始终可用
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
